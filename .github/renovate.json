{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["* 18 * * 5"],
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major",
      "matchUpdateTypes": ["patch", "minor", "pin", "digest", "lockFileMaintenance"],
      "matchPackageNames": ["*"],
      "description": "Group all non-major updates, including Vite+, into a single PR."
    },
    {
      "groupName": "vite+",
      "groupSlug": "vite-plus",
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["vite-plus", "vite", "@voidzero-dev/**"],
      "description": "Group major Vite+ updates; pnpm-workspace.yaml pins vite and vite-plus to the catalog version via an override, so bump them together."
    },
    {
      "matchPackageNames": ["vite-plus", "vite", "@voidzero-dev/**", "@vizejs/**"],
      "minimumReleaseAge": "0",
      "description": "These packages are excluded from minimumReleaseAge in pnpm-workspace.yaml, so accept their releases immediately."
    }
  ],
  "vulnerabilityAlerts": {
    "postUpdateOptions": ["pnpmDedupe"]
  }
}
