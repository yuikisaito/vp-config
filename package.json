{
  "name": "@yuikisaito/vp-config",
  "version": "1.0.0",
  "description": "Vite+ configuration for @yuikisaito",
  "homepage": "https://github.com/yuikisaito/vp-config#readme",
  "bugs": {
    "url": "https://github.com/yuikisaito/vp-config/issues"
  },
  "license": "MIT",
